# Kopiraj v .env.local in izpolni. Vrednosti najdeš v Supabase: Project Settings -> API (Data API / API Keys).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) ali legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Ime Storage bucketa s slikami in (neobvezno) podmapa, v kateri so slike
NEXT_PUBLIC_SLIKE_BUCKET=Slike_rabljena_oprema
NEXT_PUBLIC_SLIKE_MAPA=
# Power Automate flow za Teams obvestilo ob novi opremi (HTTP URL sprožilca "When a Teams webhook request is received").
# SKRIVNOST: brez NEXT_PUBLIC_, ne objavljaj. Če je prazno, se obvestilo ne pošlje.
TEAMS_WEBHOOK_URL=# Power Automate flow za Teams obvestilo, ko je oprema označena kot PRODANO (flow "Rabljena oprema Vercel - prodana oprema
# - message to teams"; aplikacija pošlje Adaptive Card, flow jo samo objavi v klepet). SKRIVNOST, prazno = ne pošlje.
TEAMS_WEBHOOK_PRODANO=
# E-mail opomniki o poteku posoje / rezervacije (Nastavitve). Power Automate flow "Rabljena oprema Vercel - opomnik
# poteka - email" (HTTP URL sprožilca "When a Teams webhook request is received"); aplikacija pošlje to / subject / html,
# flow samo pošlje e-mail. SKRIVNOST, prazno = ne pošlje.
EMAIL_WEBHOOK_OPOMNIKI=
# Dnevno preverjanje opomnikov (Vercel Cron -> /api/opomniki). CRON_SECRET: poljuben dolg naključen niz (Vercel ga pošlje
# v glavi Authorization). SUPABASE_SERVICE_ROLE_KEY: Supabase -> Project Settings -> API Keys -> service_role / secret.
# Oba SAMO na strežniku (nikoli NEXT_PUBLIC_).
CRON_SECRET=
SUPABASE_SERVICE_ROLE_KEY=
